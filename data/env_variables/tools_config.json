{
  "tools": {
    "extract_table_data": {
      "name": "表格数据提取",
      "description": "从 Markdown 格式表格中精确提取指定行列的数值。用于规则以表格形式呈现（如各地区电价上限表）时，替代 LLM 直接读表避免看错行列。",
      "triggers": ["表格", "下表", "如下表", "价格表", "上限表"],
      "parameters": {
        "table_text": "Markdown 格式的完整表格文本",
        "filter_column": "用于定位目标行的列名",
        "filter_value": "用于定位目标行的值（支持模糊匹配）",
        "select_column": "要提取数值的列名"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["table_text", "filter_column", "filter_value", "select_column"],
        "properties": {
          "table_text": {"type": "string"},
          "filter_column": {"type": "string"},
          "filter_value": {"type": "string"},
          "select_column": {"type": "string"}
        }
      },
      "output": {"value": "number", "unit": "string", "row_number": "int"}
    },
    "arithmetic_compare": {
      "name": "精确算术比较",
      "description": "对实际值与规则阈值进行精确比较。规则审查的核心判断——\"800 > 760 吗？\"由代码计算而非 LLM 推理，保证 100% 准确。",
      "triggers": ["比较", "对比", "是否超过", "是否低于", "大于", "小于", "等于", "介于"],
      "parameters": {
        "actual": "实际值（数值，必须先通过 unit_converter 统一单位）",
        "operator": "比较运算符：gt(大于) / gte(大于等于) / lt(小于) / lte(小于等于) / eq(等于) / neq(不等于) / between(介于两端之间)",
        "threshold": "阈值",
        "threshold_high": "上限（仅 between 时需要）"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["actual", "operator", "threshold"],
        "properties": {
          "actual": {"type": "number"},
          "operator": {"type": "string", "enum": ["gt", "gte", "lt", "lte", "eq", "neq", "between"]},
          "threshold": {"type": "number"},
          "threshold_high": {"type": "number"}
        }
      },
      "output": {"result": "boolean", "expression": "string", "detail": "string"}
    },
    "resolve_cross_reference": {
      "name": "规则交叉引用解析",
      "description": "解析规则文本中的交叉引用（如'参照第5条第2款'、'按照《XXX》第三章执行'），在被引位置找到对应的规则原文。",
      "triggers": ["参照", "按照", "依据", "按照...执行", "第X条", "详见"],
      "parameters": {
        "reference_text": "包含交叉引用语句的文本片段"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["reference_text"],
        "properties": {
          "reference_text": {"type": "string"}
        }
      },
      "output": {"references": "array", "each": {"type": "string", "pattern": "string", "resolved_text": "string", "source": "string"}}
    },
    "validate_date_applicability": {
      "name": "规则时效性校验",
      "description": "判断某条规则在给定日期是否有效。检查规则的施行日期和废止日期，防止用旧规则判断新交易。",
      "triggers": ["施行", "废止", "有效期", "生效", "失效", "版本"],
      "parameters": {
        "rule_text": "包含日期信息的规则文本",
        "query_date": "查询日期，格式 YYYY-MM-DD"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["rule_text", "query_date"],
        "properties": {
          "rule_text": {"type": "string"},
          "query_date": {"type": "string"}
        }
      },
      "output": {"is_applicable": "boolean", "effective_date": "string", "expiry_date": "string|null", "version": "string", "reason": "string"}
    },
    "unit_converter": {
      "name": "单位转换",
      "description": "电力交易单位换算。用户说的值和规则写的值单位可能不同（如万kWh vs MWh），转换后统一比较。",
      "triggers": ["万kWh", "亿kWh", "GWh", "kWh", "分/kWh", "元/千度"],
      "parameters": {
        "value": "待转换的数值",
        "from_unit": "原单位",
        "to_unit": "目标单位"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["value", "from_unit", "to_unit"],
        "properties": {
          "value": {"type": "number"},
          "from_unit": {"type": "string"},
          "to_unit": {"type": "string"}
        }
      },
      "output": {"value": "number", "unit": "string"}
    },
    "locate_clause": {
      "name": "条款定位器",
      "description": "按'第X条第Y款'在规则文档中精确定位条款原文，返回完整条款文本与来源位置。用于校验引用是否真实存在，或补检遗漏的规则条款（如 Judge 提示缺失某条规则时）。",
      "triggers": ["第X条", "第X款", "条款定位", "找到条款", "核实条款", "补检", "遗漏条款"],
      "parameters": {
        "article_no": "条款号，支持阿拉伯数字、中文数字或'第12条'完整形式",
        "paragraph_no": "款号，可选",
        "doc_name": "文档名过滤，跨文档检索时必须传",
        "chunks": "候选检索 chunks 列表（工具执行时由系统注入）",
        "all_chunks": "全量 chunks 列表，候选未命中时的备选（系统注入）"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["article_no"],
        "properties": {
          "article_no": {},
          "paragraph_no": {},
          "doc_name": {"type": "string"},
          "chunks": {"type": "array"},
          "all_chunks": {"type": "array"}
        }
      },
      "output": {"found": "boolean", "clause_text": "string", "paragraph_text": "string", "match_level": "string", "source": "string", "page": "int"}
    },
    "verify_citation": {
      "name": "证据引用核验",
      "description": "校验 evidence 引用的来源文档、章节、页码与原文文本是否一致。在输出引用前调用，拦截编造或改写的引用，减轻 Judge 校验负担。",
      "triggers": ["核实引用", "验证引用", "核对来源", "证据核验", "引用是否准确", "引用是否真实"],
      "parameters": {
        "evidence_text": "待核验的 evidence 原文引用文本",
        "claimed_source": "声称的文档名（可带《》）",
        "claimed_section": "声称的章节标题",
        "claimed_page": "声称的页码，0 表示未声称（跳过页码校验）",
        "claimed_chunk_id": "声称的 chunk_id，非空时优先与该 chunk 比对",
        "chunks": "检索结果 chunks 列表（系统注入）"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["evidence_text"],
        "properties": {
          "evidence_text": {"type": "string"},
          "claimed_source": {"type": "string"},
          "claimed_section": {"type": "string"},
          "claimed_page": {"type": "integer"},
          "claimed_chunk_id": {"type": "string"},
          "chunks": {"type": "array"}
        }
      },
      "output": {"verified": "boolean", "text_match_ratio": "number", "source_matched": "boolean", "section_matched": "boolean", "page_matched": "boolean", "issues": "array"}
    },
    "extract_numeric_fact": {
      "name": "数值事实提取",
      "description": "从非表格的规则正文中提取'主体+数值+单位'三元组。规则正文中的大量数值（如'冀北现货出清电价上限为800元/MWh'）不在表格里，用本工具精确提取避免 LLM 漏读或估算。",
      "triggers": ["提取数值", "正文中的数字", "数值事实", "规定多少", "事实提取", "数值提取"],
      "parameters": {
        "text": "规则正文文本片段",
        "subject": "可选主体限定，只返回该主体的 fact（如'冀北'）",
        "max_facts": "最多返回的 fact 数，默认 20"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {"type": "string"},
          "subject": {"type": "string"},
          "max_facts": {"type": "integer"}
        }
      },
      "output": {"facts": "array", "each": {"subject": "string", "value": "number", "unit": "string", "raw": "string", "position": "int"}}
    },
    "detect_rule_conflict": {
      "name": "多文档冲突检测",
      "description": "检测多个规则文档对同一事项的规定是否冲突。先对双方条文提取数值并单位归一化后比较；无数值场景按文本相似度判断，不硬判语义冲突。建议先调用 locate_clause 定位双方条款原文。",
      "triggers": ["冲突", "不一致", "矛盾", "规定不同", "两个文档", "以哪个为准", "孰高孰低", "哪个规定"],
      "parameters": {
        "pairs": "待检测的规则对数组，每项含 doc_a/doc_b/topic/rule_a_text/rule_b_text"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["pairs"],
        "properties": {
          "pairs": {"type": "array"}
        }
      },
      "output": {"conflicts": "array", "each": {"doc_a": "string", "doc_b": "string", "topic": "string", "conflict": "boolean", "conflict_type": "string", "reason": "string"}}
    }
  }
}
